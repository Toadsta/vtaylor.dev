<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🌙 Victoria Taylor — <%= title %></title>
    <link rel="stylesheet" href="/css/torium.css">
    <link rel="stylesheet" href="/css/torium-nav-foot.css">
    <link rel="stylesheet" href="/css/torium-misc.css">
    <link rel="stylesheet" href="/css/torium-content.css">
    <link rel="stylesheet" href="/css/torium-about.css">
</head>

<body>

<div class="flex-box"></div>

<div class="main-container">
    <nav class="fira-mono-regular">
        <a class="nav-logo fira-mono-bold">[tori] $ <span class="blink">▋</span></a>
        <div class="nav-items">
            <a class="home" href="/about">
                <span class="fira-mono-bold">./</span>about
            </a>
            <a href="/blog">
                <span class="fira-mono-bold">./</span>blog
            </a>
            <a href="/projects">
                <span class="fira-mono-bold">./</span>projects
            </a>
            <a href="/vicos">
                <span class="fira-mono-bold">./</span>vicos
            </a>
        </div>
    </nav>

    <div class="container">
        <div class="section-left fira-mono-regular">
            <%- include(body) %>
        </div>
    </div>

    <footer class="fira-mono-regular">
        <div class="footer-text">
            Copyright <%= new Date().getFullYear() %>, Victoria Taylor <br>
            Inspired by the <a class="fira-mono-bold" href="https://github.com/joeroe/risotto">Rissoto</a> theme for
            <a class="fira-mono-bold" href="https://github.com/gohugoio/hugo">Hugo</a>
        </div>
        <button id="theme-toggle" aria-label="Toggle dark mode"></button>
    </footer>
</div>

<div class="flex-box"></div>

<script src="/javascript/themeToggle.js"></script>

</body>
</html>