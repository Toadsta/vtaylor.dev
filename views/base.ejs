<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= settings.name %> — <%= title %></title>
    <link rel="icon" type="image/png" sizes="32x32" href="<%= basePath %>/images/favicon-32.png" id="favicon-32">
    <link rel="icon" type="image/png" sizes="16x16" href="<%= basePath %>/images/favicon-16.png" id="favicon-16">
    <link rel="apple-touch-icon" href="<%= basePath %>/images/apple-touch-icon.png" id="apple-touch-icon">
    <link rel="stylesheet" href="<%= basePath %>/css/torium.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="<%= basePath %>/css/torium-nav-foot.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="<%= basePath %>/css/torium-misc.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="<%= basePath %>/css/torium-content.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="<%= basePath %>/css/torium-about.css?v=<%= assetVersion %>">
    <style>
        :root {
            --color-bg: <%= theme.light.bg %>;
            --color-panel-bg: <%= theme.light.panelBg %>;
            --color-text: <%= theme.light.text %>;
            --color-text-muted: <%= theme.light.textMuted %>;
            --color-badge-bg: <%= theme.light.badgeBg %>;
            --color-badge-text: <%= theme.light.badgeText %>;
            --color-accent: <%= theme.light.accent %>;
            --color-footer-link: <%= theme.light.footerLink %>;
            color-scheme: light;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --color-bg: <%= theme.dark.bg %>;
                --color-panel-bg: <%= theme.dark.panelBg %>;
                --color-text: <%= theme.dark.text %>;
                --color-text-muted: <%= theme.dark.textMuted %>;
                --color-badge-bg: <%= theme.dark.badgeBg %>;
                --color-badge-text: <%= theme.dark.badgeText %>;
                --color-accent: <%= theme.dark.accent %>;
                --color-footer-link: <%= theme.dark.footerLink %>;
                color-scheme: dark;
            }
        }
        :root[data-theme="light"] {
            --color-bg: <%= theme.light.bg %>;
            --color-panel-bg: <%= theme.light.panelBg %>;
            --color-text: <%= theme.light.text %>;
            --color-text-muted: <%= theme.light.textMuted %>;
            --color-badge-bg: <%= theme.light.badgeBg %>;
            --color-badge-text: <%= theme.light.badgeText %>;
            --color-accent: <%= theme.light.accent %>;
            --color-footer-link: <%= theme.light.footerLink %>;
            color-scheme: light;
        }
        :root[data-theme="dark"] {
            --color-bg: <%= theme.dark.bg %>;
            --color-panel-bg: <%= theme.dark.panelBg %>;
            --color-text: <%= theme.dark.text %>;
            --color-text-muted: <%= theme.dark.textMuted %>;
            --color-badge-bg: <%= theme.dark.badgeBg %>;
            --color-badge-text: <%= theme.dark.badgeText %>;
            --color-accent: <%= theme.dark.accent %>;
            --color-footer-link: <%= theme.dark.footerLink %>;
            color-scheme: dark;
        }
    </style>
</head>

<body>

<div class="main-container">
    <nav class="fira-mono-regular">
        <a class="nav-logo fira-mono-bold">[<%= settings.tagline %>] $ <span class="blink">▋</span></a>
        <div class="nav-items">
            <a class="home" href="<%= basePath %>/about">
                <span class="fira-mono-bold">./</span>about
            </a>
            <a href="<%= basePath %>/blog">
                <span class="fira-mono-bold">./</span>blog
            </a>
            <a href="<%= basePath %>/projects">
                <span class="fira-mono-bold">./</span>projects
            </a>
        </div>
    </nav>

    <div class="container">
        <div class="section-left fira-mono-regular">
            <%- include(body) %>
        </div>
    </div>

    <footer class="fira-mono-regular">
        <div class="footer-text">
            <div class="footer-links">
                <a class="footer-icon-link" href="<%= settings.github %>" aria-label="GitHub" target="_blank" rel="noopener">
                    <svg viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
                </a>
                <a class="footer-icon-link" href="<%= settings.linkedin %>" aria-label="LinkedIn" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                </a>
                <a class="footer-icon-link" href="mailto:<%= settings.email %>" aria-label="Email">
                    <svg class="icon-stroke" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M4 7l8 6 8-6"></path></svg>
                </a>
            </div>
            Copyright <%= new Date().getFullYear() %>, <%= settings.name %>
        </div>
        <div class="footer-right">
            <% if (settings.secretLink) { %>
            <a class="secret-link" href="<%= settings.secretLink %>" aria-label="VicOS">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="1"></rect><line x1="8" y1="20" x2="16" y2="20"></line><line x1="12" y1="16" x2="12" y2="20"></line></svg>
            </a>
            <% } %>
            <button id="theme-switcher" aria-label="Switch color theme">
                <svg viewBox="0 0 24 24"><path d="M12 3C7 3 3 6.6 3 11c0 3 2 5 4.5 5H9a1.5 1.5 0 011.5 1.5c0 .5-.2.9-.5 1.3-.3.4-.5.8-.5 1.2 0 1 .8 2 2.5 2 5 0 9-4 9-9 0-5-4-9-9-9z"></path><circle cx="7.5" cy="10.5" r="1"></circle><circle cx="10.5" cy="7" r="1"></circle><circle cx="15" cy="7" r="1"></circle><circle cx="17.5" cy="10.5" r="1"></circle></svg>
            </button>
            <button id="theme-toggle" aria-label="Toggle dark mode"></button>
        </div>
    </footer>
</div>

<script>
    window.__THEMES = <%- JSON.stringify(themes) %>;
    window.__CURRENT_THEME = <%- JSON.stringify(themes[settings.theme] ? settings.theme : 'birch') %>;
</script>
<script src="<%= basePath %>/javascript/themeToggle.js?v=<%= assetVersion %>"></script>

</body>
</html>