<h1 class="title"># blog</h1>
<% if (posts.length === 0) { %>
<p class="content">coming soon — check back later.</p>
<% } %>
<div class="post-list">
    <% posts.forEach(function(post) { %>
    <a class="post-list-item" href="<%= basePath %>/blog/<%= post.slug %>">
        <% if (post.pin != null) { %>
        <svg class="pin-icon" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
        <% } %>
        <div class="post-list-title fira-mono-bold"><%= post.title %></div>
        <div class="post-list-date"><%= new Date(post.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
        <p class="post-list-excerpt"><%= post.excerpt %></p>
        <div class="post-tag-row">
            <% (post.tags || []).forEach(function(t) { %><span class="tech-tag"><%= t %></span><% }); %>
        </div>
    </a>
    <% }); %>
</div>
