<a class="post-back" href="<%= basePath %>/blog"><span class="fira-mono-bold">./</span>back to blog</a>
<div class="post-detail-header">
    <h1 class="post-detail-title fira-mono-bold"><%= post.title %></h1>
    <div class="post-detail-meta">
        <div class="post-tag-row">
            <% (post.tags || []).forEach(function(t) { %><span class="tech-tag"><%= t %></span><% }); %>
        </div>
    </div>
</div>
<div class="post-date"><%= new Date(post.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
<div class="post-detail-body<%= post.image ? ' has-image' : '' %>">
    <% if (post.image) { %><img class="post-detail-image" src="<%= basePath %><%= post.image %>" alt="<%= post.title %>"><% } %>
    <div class="post-body content"><%- post.html %></div>
</div>
